# --- 백엔드 선택 ---
# claude  = Anthropic API (권장). 인증은 ANTHROPIC_API_KEY 하나면 된다.
# vertex  = Vertex AI(Gemini). 사내 GCP 프로젝트가 필요하다 (docs/migration_vertexAI.md)
# offline = LLM을 호출하지 않는 결정론적 스텁. 실데이터 분석 불가(더미/샘플 검증용)
SVMTRIAL_BACKEND=offline

# --- Claude (SVMTRIAL_BACKEND=claude 일 때) ---
# 아래 한 줄이면 동작한다. 모델 ID·effort 는 config/config.yaml 의 claude 절에서 조정한다.
# ANTHROPIC_API_KEY=sk-ant-...
# 또는 키를 파일에 두지 않으려면:  ant auth login   (프로필을 SDK가 자동으로 찾는다)

# --- Vertex AI (SVMTRIAL_BACKEND=vertex 일 때 필수) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global            # IT 정책에 따라 asia-northeast3 등 (SETUP.md §15)
# 인증 방식 B일 때만:
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\svmtrial-sa.json
# --- 모델 ID: check_gemini.py --list-only 결과에서 골라 기입 ---
GEMINI_MODEL_FAST=                      # OCR/개념 채점용 Flash 계열 (예: 3.x Flash)
GEMINI_MODEL_PRO=                       # 가설 생성/템플릿 작성용 Pro 계열 (예: 3.x Pro)
# --- 사내 프록시 (필요 시) ---
# HTTPS_PROXY=http://proxy.company:8080
# SSL_CERT_FILE=C:\certs\corp-ca.pem
